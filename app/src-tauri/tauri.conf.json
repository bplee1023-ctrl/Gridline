{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gridline",
  "version": "1.0.0",
  "identifier": "io.github.gridline.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/configure.mjs",
    "beforeDevCommand": "node scripts/configure.mjs",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gridline",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Sports",
    "shortDescription": "NFL advanced player rankings",
    "copyright": "Stats: nflverse, FTN Data via nflverse",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
